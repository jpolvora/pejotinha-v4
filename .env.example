# Database
# No Supabase Local (Self-hosted Dev), a porta padrão é 54322
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=postgres
DB_PORT=54322

# Supabase Auth (Local Dev via CLI)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="youranonkey"
SUPABASE_SERVICE_ROLE_KEY="yourservicerolekey"

# Telegram Integration
TELEGRAM_BOT_TOKEN="yourbottoken"

# Security (For encrypting user settings in the DB)
# Generate a random 32-character string for AES-256-GCM
ENCRYPTION_SECRET="your_32_chars_long_encryption_secret"

# Webhooks Secret (Azure DevOps, etc)
WEBHOOK_SECRET="your_shared_webhook_secret"

# Development / Seeding
SEED_USER_ID="00000000-0000-0000-0000-000000000001"

# --- COOLIFY DEPLOYMENT CONFIGS ---
PJ_COOLIFY_URL=http://192.168.0.70:8000
PJ_COOLIFY_TOKEN=your_coolify_api_token
PJ_COOLIFY_SERVER_ID=your_server_uuid
PJ_COOLIFY_PROJECT_ID=your_project_uuid
PJ_COOLIFY_APP_NAME=pejotinha-v4
PJ_DOCKER_REGISTRY=ghcr.io
PJ_DOCKER_USERNAME=your_docker_username
