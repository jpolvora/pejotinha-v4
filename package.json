{
  "name": "pejotinha-v4",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/env-run.mjs next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint .",
    "stop": "npx supabase stop",
    "setup": "npm install && node scripts/setup.mjs",
    "db:push": "node scripts/env-run.mjs \"npx prisma db push && node scripts/sync-auth.mjs\"",
    "db:setup-supabase": "npx prisma db execute --file scripts/setup-supabase.sql",
    "reset:db": "node scripts/env-run.mjs \"npx prisma db push --force-reset && node scripts/sync-auth.mjs && npx prisma db seed && npm run db:setup-supabase\"",
    "deploy": "node scripts/deploy.mjs",
    "supabase:link": "supabase link",
    "prepare": "husky",
    "type-check": "tsc --noEmit",
    "check:all": "npm run lint && npm run type-check && node scripts/check-sanity.mjs",
    "from:ghcr": "docker run -it --rm -p 3001:3000 --env-file .env.local --add-host host.docker.internal:host-gateway --name pejotinha-test ghcr.io/jpolvora/pejotinha-v4:latest"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "echo 'Committing...'"
    ]
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/google": "^3.0.53",
    "@ai-sdk/openai": "^3.0.48",
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^7.6.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "@swc/helpers": "0.5.20",
    "@tailwindcss/postcss": "^4.2.2",
    "ai": "^6.0.137",
    "autoprefixer": "^10.4.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.577.0",
    "next": "^16.2.1",
    "next-intl": "^4.8.3",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.0",
    "shadcn": "^4.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/config": "^7.5.0",
    "@secretlint/secretlint-rule-preset-recommend": "^11.4.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pg": "^8.20.0",
    "prisma": "^7.6.0",
    "secretlint": "^11.4.0",
    "supabase": "^2.84.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}