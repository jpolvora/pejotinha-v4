{
  "name": "pejotinha-v4",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx supabase start && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "stop": "npx supabase stop",
    "setup": "npm install && node scripts/setup-env.mjs && npx prisma db push && node scripts/sync-auth.mjs && npx prisma db seed && npx prisma db execute --file scripts/fix-permissions.sql --schema prisma/schema.prisma",
    "reset:db": "npx prisma db push --force-reset && node scripts/sync-auth.mjs && npx prisma db seed && npx prisma db execute --file scripts/fix-permissions.sql --schema prisma/schema.prisma",
    "deploy": "sh deploy.sh",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "echo 'Committing...'"
    ]
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.53",
    "@ai-sdk/openai": "^3.0.48",
    "@base-ui/react": "^1.3.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "ai": "^6.0.137",
    "autoprefixer": "^10.4.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.577.0",
    "next": "^16.2.1",
    "next-themes": "^0.4.6",
    "npx": "^10.2.2",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.0",
    "shadcn": "^4.1.0",
    "sonner": "^2.0.7",
