{
  "name": "pejotinha-v4",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx supabase start && next dev",
    "dev:cloud": "NEXT_PUBLIC_SUPABASE_URL=$(grep NEXT_PUBLIC_SUPABASE_URL .env.cloud | cut -d '=' -f2) NEXT_PUBLIC_SUPABASE_ANON_KEY=$(grep NEXT_PUBLIC_SUPABASE_ANON_KEY .env.cloud | cut -d '=' -f2) next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint .",
    "stop": "npx supabase stop",
    "setup": "npm install && node scripts/setup-env.mjs .env && npx prisma db push && node scripts/sync-auth.mjs && npx prisma db seed && npm run db:setup-supabase",
    "setup:cloud": "npm install && node scripts/setup-cloud.mjs && npx prisma db push && node scripts/sync-auth.mjs",
    "reset:db": "npx prisma db push --force-reset && node scripts/sync-auth.mjs && npx prisma db seed && npm run db:setup-supabase",
    "deploy": "sh deploy.sh",
    "deploy:cloud": "sh scripts/deploy-cloud.sh",
    "supabase:link": "supabase link",
    "prepare": "husky",
    "db:setup-supabase": "npx prisma db execute --file scripts/setup-supabase.sql --schema prisma/schema.prisma",
    "type-check": "tsc --noEmit",
    "check:all": "npm run lint && npm run type-check && node scripts/check-sanity.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "echo 'Committing...'"
    ]
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/google": "^3.0.53",
    "@ai-sdk/openai": "^3.0.48",
    "@base-ui/react": "^1.3.0",
    "@prisma/client": "^5.22.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "@tailwindcss/postcss": "^4.2.2",
    "ai": "^6.0.137",
    "autoprefixer": "^10.4.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.577.0",
    "next": "^16.2.1",
    "next-themes": "^0.4.6",
    "npx": "^10.2.2",
    "postcss": "^8.5.8",
    "prisma": "^5.22.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.0",
    "shadcn": "^4.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@prisma/config": "^7.5.0",
    "@secretlint/secretlint-rule-preset-recommend": "^11.4.0",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "secretlint": "^11.4.0",
    "supabase": "^2.84.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
