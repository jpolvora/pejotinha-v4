generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model Profile {
  id                String          @id @db.Uuid
  email             String          @unique
  fullName          String?         @map("full_name")
  role              user_role       @default(freelancer)
  createdAt         DateTime        @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(dbgenerated("timezone('utc'::text, now())")) @map("updated_at") @db.Timestamptz(6)
  settings          Json?           @default("{}")
  webhookSecret     String?         @unique @map("webhook_secret")
  defaultHourlyRate Decimal?        @default(0.00) @map("default_hourly_rate") @db.Decimal
  apiKey            String?         @unique @map("api_key")
  approvals         Approval[]
  customers         Customer[]      @relation("FreelancerCustomers")
  invoices          Invoice[]
  personalEvents    PersonalEvent[]
  clientProjects    Project[]       @relation("ClientProjects")
  projects          Project[]       @relation("FreelancerProjects")
  expenses          Expense[]
  invitations       Invitation[]
  projectAccess     ProjectAccess[]

  @@map("profiles")
  @@schema("public")
}

model Customer {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  freelancerId String    @map("freelancer_id") @db.Uuid
  name         String
  slug         String?   @unique
  email        String?
  hourlyRate   Decimal?  @default(0.00) @map("hourly_rate") @db.Decimal
  createdAt    DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  freelancer   Profile   @relation("FreelancerCustomers", fields: [freelancerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  projects     Project[]
  invoices     Invoice[]

  @@map("customers")
  @@schema("public")
}

model Project {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  freelancerId    String         @map("freelancer_id") @db.Uuid
  customerId      String         @map("customer_id") @db.Uuid
  clientProfileId String?        @map("client_profile_id") @db.Uuid
  name            String
  slug            String?        @unique
  description     String?
  status          project_status @default(active)
  createdAt       DateTime       @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  hourly_rate     Decimal        @default(0.00) @db.Decimal
  tech_stacks     String[]       @default([])
  activities      Activity[]
  invoices        Invoice[]
  clientProfile   Profile?       @relation("ClientProjects", fields: [clientProfileId], references: [id], onUpdate: NoAction)
  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  freelancer      Profile        @relation("FreelancerProjects", fields: [freelancerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tasks           Task[]
  expenses        Expense[]
  invitations     Invitation[]
  projectAccess   ProjectAccess[]

  @@map("projects")
  @@schema("public")
}

model Activity {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId       String          @map("project_id") @db.Uuid
  description     String
  executionPlan   String?         @map("execution_plan")
  durationMinutes Int             @default(0) @map("duration_minutes")
  createdAt       DateTime        @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  startTime       DateTime?       @default(dbgenerated("timezone('utc'::text, now())")) @map("start_time") @db.Timestamptz(6)
  endTime         DateTime?       @default(dbgenerated("timezone('utc'::text, now())")) @map("end_time") @db.Timestamptz(6)
  sprint          String?
  ticket          String?
  value           Decimal?        @default(0.00) @db.Decimal
  taskId          String?         @map("task_id") @db.Uuid
  source          String          @default("manual")
  externalId      String?         @map("external_id")
  status          activity_status @default(pending)
  isPaid          Boolean         @default(false) @map("is_paid")
  paidAt          DateTime?       @map("paid_at") @db.Timestamptz(6)
  summary         String?
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  task            Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  approvals       Approval[]
  evidences       Evidence[]

  @@map("activities")
  @@schema("public")
}

model Evidence {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId   String   @map("activity_id") @db.Uuid
  fileUrl      String?  @map("file_url")
  createdAt    DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  evidenceType String   @default("file") @map("evidence_type")
  content      String?
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("evidences")
  @@schema("public")
}

model Approval {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId String          @map("activity_id") @db.Uuid
  clientId   String          @map("client_id") @db.Uuid
  status     approval_status
  feedback   String?
  createdAt  DateTime        @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  activity   Activity        @relation(fields: [activityId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  client     Profile         @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("approvals")
  @@schema("public")
}

model PersonalEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  freelancerId String   @map("freelancer_id") @db.Uuid
  title        String
  description  String?
  startTime    DateTime @map("start_time") @db.Timestamptz(6)
  endTime      DateTime @map("end_time") @db.Timestamptz(6)
  proofUrl     String?  @map("proof_url")
  createdAt    DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  freelancer   Profile  @relation(fields: [freelancerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("personal_events")
  @@schema("public")
}

model Invoice {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  freelancerId String         @map("freelancer_id") @db.Uuid
  customerId   String         @map("customer_id") @db.Uuid
  projectId    String?        @map("project_id") @db.Uuid
  amount       Decimal        @db.Decimal
  currency     String         @default("BRL")
  status       invoice_status @default(draft)
  description  String?
  issuedAt     DateTime       @default(dbgenerated("timezone('utc'::text, now())")) @map("issued_at") @db.Timestamptz(6)
  dueDate      DateTime?      @map("due_date") @db.Timestamptz(6)
  paidAt       DateTime?      @map("paid_at") @db.Timestamptz(6)
  periodStart  DateTime?      @map("period_start") @db.Timestamptz(6)
  periodEnd    DateTime?      @map("period_end") @db.Timestamptz(6)
  createdAt    DateTime       @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  freelancer   Profile        @relation(fields: [freelancerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("invoices")
  @@schema("public")
}

model Task {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String      @map("project_id") @db.Uuid
  name        String
  description String?
  status      task_status @default(pending)
  dueDate     DateTime?   @map("due_date") @db.Timestamptz(6)
  createdAt   DateTime    @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activities  Activity[]

  @@map("tasks")
  @@schema("public")
}

model Expense {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  freelancerId String   @map("freelancer_id") @db.Uuid
  projectId    String?  @map("project_id") @db.Uuid
  description  String
  amount       Decimal  @db.Decimal
  category     String?
  date         DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  receiptUrl   String?  @map("receipt_url")
  createdAt    DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  freelancer   Profile  @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("expenses")
  @@schema("public")
}

enum activity_status {
  pending
  approved
  rejected
  pending_evidence

  @@schema("public")
}

enum client_access_role {
  owner
  supervisor

  @@schema("public")
}

enum invitation_status {
  pending
  accepted
  expired

  @@schema("public")
}

enum approval_status {
  approved
  rejected
  revision

  @@schema("public")
}

enum user_role {
  freelancer
  client

  @@schema("public")
}

enum project_status {
  active
  completed

  @@schema("public")
}

enum invoice_status {
  draft
  sent
  paid
  overdue

  @@schema("public")
}

enum task_status {
  pending
  doing
  done

  @@schema("public")
}

model Invitation {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String
  projectId    String            @map("project_id") @db.Uuid
  freelancerId String            @map("freelancer_id") @db.Uuid
  status       invitation_status @default(pending)
  role         client_access_role @default(owner)
  token        String            @unique
  expiresAt    DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime          @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @default(dbgenerated("timezone('utc'::text, now())")) @map("updated_at") @db.Timestamptz(6)

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancer Profile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@map("invitations")
  @@schema("public")
}

model ProjectAccess {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String             @map("project_id") @db.Uuid
  profileId String             @map("profile_id") @db.Uuid
  role      client_access_role @default(owner)
  createdAt DateTime           @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([projectId, profileId])
  @@map("project_access")
  @@schema("public")
}
